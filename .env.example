# Identifiant public de l’inscription d’application Microsoft Entra (jamais un secret)
VITE_MICROSOFT_CLIENT_ID=
# common accepte comptes personnels Microsoft et comptes professionnels/scolaires
VITE_MICROSOFT_TENANT_ID=common
# Facultatif : par défaut, MSAL utilise window.location.origin
VITE_MICROSOFT_REDIRECT_URI=http://localhost:5173
